# AI provider (scoring + drafting). Interim choice: Gemini via @google/genai --
# the original spec targets Anthropic (ANTHROPIC_API_KEY, SCORING_MODEL
# default "claude-sonnet-5"); ask before assuming this has reverted.
GEMINI_API_KEY=
SCORING_MODEL=gemini-3.1-pro-preview

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=

# Supabase (server-only; service role key must never reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard auth
DASHBOARD_PASSWORD=
# Random 32+ byte secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Email safety switch: unset or anything other than "live" keeps every send
# routed to TEST_RECIPIENT with the real recipient shown in the subject line.
EMAIL_MODE=
TEST_RECIPIENT=

# Interview scheduling link inserted into invite emails
SCHEDULING_URL=
